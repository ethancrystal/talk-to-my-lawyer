# ── Self-hosted GitHub Actions runner config ─────────────────────────────────
# Copy to .env.runner (gitignored) and fill in GH_PAT. NEVER commit a real token.

# Repo the runner attaches to.
REPO_URL=https://github.com/moizj00/ttml-app

# Recommended: a GitHub PAT used to auto-fetch short-lived registration/removal
# tokens (lets the runner both register AND cleanly deregister on shutdown).
#   • Classic PAT:      scope `repo`
#   • Fine-grained PAT: this repo + Administration: Read and write
GH_PAT=

# Alternative to GH_PAT: a one-shot registration token from
# repo → Settings → Actions → Runners → "New self-hosted runner" (expires ~1h).
# RUNNER_TOKEN=

# Optional overrides:
# RUNNER_NAME=ttml-local
RUNNER_LABELS=self-hosted,linux,x64
# RUNNER_EPHEMERAL=false   # true = a fresh runner per job (cleanest isolation)
