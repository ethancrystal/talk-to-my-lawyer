{
  "version": 2,
  "build": {
    "env": {
      "NODE_ENV": "production",
      "PUPPETEER_SKIP_DOWNLOAD": "true",
      "PIPELINE_MODE": "simple"
    }
  },
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "attached_assets/**",
          "server/pipeline/prompts/**",
          "certs/**",
          "dist/public/**",
          "drizzle/**"
        ],
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/api/index.ts" }
  ]
}
